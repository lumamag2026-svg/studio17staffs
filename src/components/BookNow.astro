---
const PHONE_DISPLAY = "07598 448 772";
const PHONE_RAW = "07598448772";
const SMS_URL = `sms:${PHONE_RAW}`;
---

<section class="booking" id="book">
  <div class="sec-label reveal">
    <span class="num">03 / Book</span>
    <h2>Reserve your <em>hour</em>.<br>Studio terms, clear pricing.</h2>
  </div>

  <div class="book-cta-grid reveal">
    <div class="book-cta-info">
      <p class="book-cta-lede">
        Message us to book your space. Three reformers per class, so spaces fill quickly.
        First-timers, start with a <em>1:1 session</em>.
      </p>

      <dl class="book-cta-meta">
        <div>
          <dt>Price</dt>
          <dd>£19.50 per class · packs of <em>5 &amp; 10</em></dd>
        </div>
        <div>
          <dt>Group size</dt>
          <dd>Three reformers, <em>always</em></dd>
        </div>
        <div>
          <dt>Cancellation</dt>
          <dd>24 hours' notice or the credit is <em>lost</em></dd>
        </div>
        <div>
          <dt>First class</dt>
          <dd>Fill in your <a href="/parq">PARQ form</a> before you come</dd>
        </div>
      </dl>
    </div>

    <a class="book-cta-btn" href={SMS_URL}>
      <div class="btn-inner">
        <span class="btn-eyebrow">{PHONE_DISPLAY}</span>
        <span class="btn-title">Message to <em>book</em></span>
        <span class="btn-sub">Text us and we'll hold your space</span>
      </div>
      <span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>
