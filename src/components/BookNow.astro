---
const BOOK_URL = "https://studio17pilates.simplybook.it/v2/";
---

<section class="booking" id="book">
  <div class="sec-label reveal">
    <span class="num">03 / Book</span>
    <h2>Reserve your <em>hour</em>.<br>Studio terms, clear pricing.</h2>
  </div>

  <div class="book-cta-grid reveal">
    <div class="book-cta-info">
      <p class="book-cta-lede">
        All bookings are taken through our <em>online system</em>. Three reformers per class, so classes fill quickly.
        First-timers, start with a <strong>Foundations</strong> class.
      </p>

      <dl class="book-cta-meta">
        <div>
          <dt>Price</dt>
          <dd>£19.50 per class · packs of <em>5 &amp; 10</em></dd>
        </div>
        <div>
          <dt>Group size</dt>
          <dd>Three reformers, <em>always</em></dd>
        </div>
        <div>
          <dt>Cancellation</dt>
          <dd>24 hours' notice or the credit is <em>lost</em></dd>
        </div>
        <div>
          <dt>First class</dt>
          <dd>Fill in your <a href="/parq">PARQ form</a> before you come</dd>
        </div>
      </dl>
    </div>

    <a class="book-cta-btn" href={BOOK_URL} target="_blank" rel="noopener">
      <div class="btn-inner">
        <span class="btn-eyebrow">Powered by SimplyBook</span>
        <span class="btn-title">Book a class <em>now</em></span>
        <span class="btn-sub">Opens the studio booking system in a new tab</span>
      </div>
      <span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>
