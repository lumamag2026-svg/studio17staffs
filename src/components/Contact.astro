---
---

<section class="contact" id="contact">
  <div class="sec-label reveal">
    <span class="num">08 / Write</span>
    <h2>Say <em>hello</em>.<br>We'll answer in a day.</h2>
  </div>

  <div class="contact-grid reveal">
    <!-- Left: info -->
    <div class="contact-info">
      <div class="contact-block">
        <div class="k">Email</div>
        <a class="v" href="mailto:hello@studio17staffs.co.uk">hello@studio17staffs.co.uk</a>
      </div>
      <div class="contact-block">
        <div class="k">Phone</div>
        <a class="v" href="tel:07598448772">07598 448 772</a>
      </div>
      <div class="contact-block">
        <div class="k">Studio</div>
        <p class="v-body">Paragon Avenue<br>Westbury Park, Staffordshire<br>ST5 4EX</p>
      </div>
      <div class="contact-block">
        <div class="k">Hours</div>
        <p class="v-body">Mon to Fri · 06:30 to 20:00<br>Sat to Sun · 08:00 to 14:00</p>
      </div>
      <div class="contact-aside">
        <p>
          To book a class or a private session, message Emma on
          <a href="https://wa.me/447598448772" target="_blank" rel="noopener">07598 448 772</a>.
        </p>
      </div>
    </div>

    <!-- Right: form -->
    <form class="contact-form" id="contact-form">
      <input type="hidden" name="_subject" value="New enquiry — Studio 17 website" />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px; width:1px; height:1px; opacity:0;" aria-hidden="true" />
      <div class="book-field">
        <label>Your name</label>
        <input required name="name" placeholder="Jane Doe" />
      </div>
      <div class="book-field">
        <label>Email</label>
        <input required type="email" name="email" placeholder="jane@email.com" />
      </div>
      <div class="book-field">
        <label>About</label>
        <select required name="topic">
          <option>General question</option>
          <option>Booking a private</option>
          <option>Pre/postnatal</option>
          <option>Injury / rehab</option>
          <option>Gift a class</option>
          <option>Press / partnership</option>
        </select>
      </div>
      <div class="book-field">
        <label>Message</label>
        <textarea required name="message" rows="6" placeholder="A few words…"></textarea>
      </div>

      <div class="book-actions" style="justify-content: flex-end">
        <button type="submit" class="book-btn" style="flex: 0 1 auto; padding-inline: 32px">Send message</button>
      </div>

      <div id="contact-ok" class="contact-ok" hidden>
        <div class="check">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12L10 17L19 7" stroke="currentColor" stroke-width="1.5"/></svg>
        </div>
        <div>
          <div class="v">Sent. Thank you.</div>
          <div class="sm">We'll reply within one working day.</div>
        </div>
      </div>

      <p id="contact-err" class="contact-err" hidden>
        Sorry, that didn't send. Please message us on <a href="https://wa.me/447598448772" target="_blank" rel="noopener">07598 448 772</a> instead.
      </p>
    </form>
  </div>
</section>

<script is:inline>
  const cf = document.getElementById("contact-form");
  const ENDPOINT = "https://formsubmit.co/ajax/emmastudio17@outlook.com";
  cf?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = cf.querySelector('button[type="submit"]');
    const err = document.getElementById("contact-err");
    err.hidden = true;
    if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
    try {
      const res = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Accept": "application/json" },
        body: new FormData(cf),
      });
      const data = await res.json();
      if (data.success === "true" || data.success === true) {
        cf.querySelectorAll("input, select, textarea, button").forEach((el) => (el.disabled = true));
        document.getElementById("contact-ok").hidden = false;
      } else {
        throw new Error(data.message || "Failed");
      }
    } catch (_) {
      err.hidden = false;
      if (btn) { btn.disabled = false; btn.textContent = "Send message"; }
    }
  });
</script>
