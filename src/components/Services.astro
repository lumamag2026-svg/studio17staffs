---
import { pricing } from "../data/schedule";

const WHATSAPP_URL = "https://wa.me/447598448772";

const services = [
  { num: "01", name: "Reformer", emph: "Class", meta: "Group · 3:1", max: "Up to three", dur: "45 minutes", price: pricing.single, unit: "per class" },
  { num: "02", name: "One", emph: "to One", meta: "1 : 1", max: "One client", dur: "45 minutes", price: pricing.privateOne, unit: "per session" },
  { num: "03", name: "Two", emph: "to One", meta: "2 : 1", max: "Two clients", dur: "45 minutes", price: pricing.privateTwo, unit: "per session" },
];
---

<section class="services tint" id="classes">
  <div class="sec-label reveal">
    <span class="num">02 / Method</span>
    <h2>One room, three <em>ways</em>.<br>Pick your ratio.</h2>
  </div>

  <ul class="svc-list reveal">
    {services.map((s) => (
      <li>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="svc-row">
          <span class="svc-num">{s.num}</span>
          <span class="svc-name">{s.name} <em>{s.emph}</em></span>
          <span class="svc-meta">Ratio<b>{s.meta}</b></span>
          <span class="svc-meta">Duration<b>{s.dur}</b></span>
          <span class="svc-price">{s.price}<small>{s.unit}</small></span>
          <span class="svc-arrow">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 13L13 1M13 1H3M13 1V11" stroke="currentColor" stroke-width="1.2"/></svg>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="svc-message reveal">
    <div class="svc-message-copy">
      <div class="svc-message-eyebrow">Not sure which fits?</div>
      <p>Message us and we'll help you pick a session, or reserve a class space for you.</p>
    </div>
    <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="svc-message-cta">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.48 1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35M12.04 21.5h-.01a9.47 9.47 0 0 1-4.83-1.32l-.35-.2-3.59.94.96-3.5-.23-.36a9.44 9.44 0 0 1-1.45-5.05c0-5.22 4.25-9.47 9.48-9.47a9.4 9.4 0 0 1 6.7 2.78 9.38 9.38 0 0 1 2.77 6.7c0 5.22-4.25 9.47-9.47 9.47M20.5 3.49A11.35 11.35 0 0 0 12.04 0C5.75 0 .63 5.12.63 11.41c0 2.01.53 3.98 1.53 5.71L.53 24l7.03-1.84a11.38 11.38 0 0 0 5.45 1.39h.01c6.29 0 11.41-5.12 11.41-11.41 0-3.05-1.19-5.91-3.35-8.06"/>
      </svg>
      Message to book <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="svc-packs reveal">
    <div class="pack">
      <div class="pack-k">Single Credit</div>
      <div class="pack-v">£19.50<small>one class</small></div>
    </div>
    <div class="pack">
      <div class="pack-k">5 Class Credits</div>
      <div class="pack-v">£87.50<small>five classes</small></div>
    </div>
    <div class="pack">
      <div class="pack-k">10 Class Credits</div>
      <div class="pack-v">£150.00<small>ten classes</small></div>
    </div>
    <div class="pack">
      <div class="pack-k">Gift Vouchers</div>
      <div class="pack-v">Available<small>any value · ask in studio</small></div>
    </div>
  </div>
</section>
