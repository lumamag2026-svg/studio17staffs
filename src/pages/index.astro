---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import BookNow from "../components/BookNow.astro";
import About from "../components/About.astro";
import Team from "../components/Team.astro";
import Quotes from "../components/Quotes.astro";
import Taster from "../components/Taster.astro";
import StudioRules from "../components/StudioRules.astro";
import Contact from "../components/Contact.astro";
---

<Layout>
  <Hero />
  <Services />

  <section class="studio-strip" aria-hidden="false">
    <div class="strip-photo reveal">
      <div class="ph">
        <img src="/team/studio-team-v2.jpg" alt="Emma, Ruby and Phoebe at Studio 17" loading="lazy" />
        <span class="ph-label"><span class="sq"></span> Emma, Ruby &amp; Phoebe</span>
        <span class="ph-tag">IMG · 04</span>
      </div>
    </div>
  </section>

  <BookNow />
  <About />
  <Team />
  <Quotes />
  <Taster />
  <StudioRules />
  <Contact />
</Layout>
