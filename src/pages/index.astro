---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import BookingCalendar from "../components/BookingCalendar.astro";
import About from "../components/About.astro";
import Team from "../components/Team.astro";
import Quotes from "../components/Quotes.astro";
import Bootcamp from "../components/Bootcamp.astro";
import StudioRules from "../components/StudioRules.astro";
import Contact from "../components/Contact.astro";
---

<Layout>
  <Hero />
  <Services />

  <section class="studio-strip" aria-hidden="false">
    <div class="strip-photo reveal">
      <div class="ph">
        <img src="/team/studio-team.jpg" alt="Emma and Ruby at Studio 17" loading="lazy" />
        <span class="ph-label"><span class="sq"></span> Emma &amp; Ruby · Studio 17</span>
        <span class="ph-tag">IMG · 04</span>
      </div>
    </div>
  </section>

  <BookingCalendar />
  <About />
  <Team />
  <Quotes />
  <Bootcamp />
  <StudioRules />
  <Contact />
</Layout>
